    {
      "parameters": {
        "jsCode": "const raw = $json.text || \"\";\nconst ep = $node[\"Tomar Primer Episodio Aprobado\"].json;\n\nconst epNumMatch = (ep[\"ID Episodio\"] || \"\").match(/\\d+/);\nconst epNum = epNumMatch ? epNumMatch[0] : \"4\";\n\nlet linkedinPost = \"\";\nlet linkedinComment = \"\";\nlet tweetText = \"\";\n\nif (raw.includes(\"[LINKEDIN_POST]\") && raw.includes(\"[LINKEDIN_COMMENT]\")) {\n  const p1 = raw.split(\"[LINKEDIN_POST]\")[1].split(\"[LINKEDIN_COMMENT]\");\n  linkedinPost = (p1[0] || \"\").trim();\n  if (p1[1].includes(\"[TWEET_X]\")) {\n    const p2 = p1[1].split(\"[TWEET_X]\");\n    linkedinComment = (p2[0] || \"\").trim();\n    tweetText = (p2[1] || \"\").trim();\n  } else {\n    linkedinComment = (p1[1] || \"\").trim();\n  }\n} else {\n  linkedinPost = raw.trim();\n  linkedinComment = \"🎧 Escúchalo en Spotify, Apple Podcasts, iVoox y web oficial: https://mgjosea.github.io/ia-sin-filtro-podcast/\";\n}\n\nif (!tweetText) {\n  tweetText = `🎙️ ¡Nuevo episodio de #IASinFiltro!\\n\\n${ep[\"ID Episodio\"]}: \\\"${ep[\"Título del Episodio\"]}\\\"\\n\\n¿Por qué la IA de hoy no es como te la contaron? Descúbrelo en 5 min:\\n👉 https://mgjosea.github.io/ia-sin-filtro-podcast/`;\n}\n\nconst videoUrl = `https://ia-sin-filtro.duckdns.org/episodes/shorts_ep${epNum}_youtube.mp4`;\nconst videoTitle = `${ep[\"Título del Episodio\"]} | ${ep[\"ID Episodio\"]} #Shorts #IASinFiltro`;\nconst videoDescription = `🎙️ ${ep[\"ID Episodio\"]}: \\\"${ep[\"Título del Episodio\"]}\\\"\\n\\n${ep[\"Concepto Clave a Explicar\"] || \"\"}\\n\\n🎧 Escucha el episodio completo en Spotify, Apple Podcasts, iVoox y web oficial:\\n👉 https://mgjosea.github.io/ia-sin-filtro-podcast/\\n\\n#IASinFiltro #InteligenciaArtificial #IA #Shorts #JoseIA`;\n\nreturn [{\n  json: {\n    action: \"publish_all_social\",\n    episodeId: ep[\"ID Episodio\"],\n    season: ep[\"Temporada\"] || \"Temporada 1\",\n    title: ep[\"Título del Episodio\"],\n    concept: ep[\"Concepto Clave a Explicar\"],\n    \n    // LinkedIn fields (all variants for Make)\n    content: linkedinPost,\n    postText: linkedinPost,\n    text: linkedinPost,\n    commentText: linkedinComment,\n    comment: linkedinComment,\n    firstComment: linkedinComment,\n    imageUrl: \"https://mgjosea.github.io/ia-sin-filtro-podcast/cover.jpg\",\n    linkedinPost: linkedinPost,\n    \n    // X (Twitter) fields (all variants for Make)\n    tweetText: tweetText,\n    tweet: tweetText,\n    twitterText: tweetText,\n    \n    // YouTube Short fields (for Make YouTube module)\n    videoUrl: videoUrl,\n    videoTitle: videoTitle,\n    videoDescription: videoDescription,\n    tags: [\"IA\", \"Inteligencia Artificial\", \"IA Sin Filtro\", \"Shorts\", \"Jose IA\", \"Tecnologia\"],\n    privacyStatus: \"public\",\n    \n    webUrl: \"https://mgjosea.github.io/ia-sin-filtro-podcast/\",\n    feedUrl: \"https://mgjosea.github.io/ia-sin-filtro-podcast/feed.xml\"\n  }\n}];"
      },
