    {
      "parameters": {
        "jsCode": "const responseText = $json.text || \"\";\nconst parts = responseText.split('---PRIMER_COMENTARIO---');\nconst postPrincipal = (parts[0] || \"\").trim();\nconst plataformas = (parts[1] || \"\").trim();\n\nconst postCompleto = plataformas ? `${postPrincipal}\\n\\n${plataformas}` : postPrincipal;\n\nconst ep = $node[\"Tomar Primer Episodio Aprobado\"].json;\n\nreturn [{\n  json: {\n    ...$json,\n    episodio: ep,\n    linkedinPost: postCompleto,\n    linkedinComment: plataformas,\n    linkedinShareUrl: `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(postCompleto)}`\n  }\n}];"
      },
      "id": "node-procesar-post-linkedin",
      "name": "Procesar Post y Comentario LinkedIn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        288
