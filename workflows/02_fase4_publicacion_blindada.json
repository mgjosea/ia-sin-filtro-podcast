        "jsonBody": "={\n  \"content\": {{ JSON.stringify(.linkedinPost) }},\n  \"postText\": {{ JSON.stringify(.linkedinPost) }},\n  \"text\": {{ JSON.stringify(.linkedinPost) }},\n  \"commentText\": {{ JSON.stringify(.linkedinComment) }},\n  \"comment\": {{ JSON.stringify(.linkedinComment) }},\n  \"firstComment\": {{ JSON.stringify(.linkedinComment) }},\n  \"imageUrl\": \"https://mgjosea.github.io/ia-sin-filtro-podcast/cover.jpg\",\n  \"episodeId\": {{ JSON.stringify([\"Tomar Primer Episodio Aprobado\"].json[\"ID Episodio\"]) }},\n  \"episodeTitle\": {{ JSON.stringify([\"Tomar Primer Episodio Aprobado\"].json[\"Título del Episodio\"]) }},\n  \"webhookUrl\": \"https://hook.eu1.make.com/ohqfjivgkw9mjeh7kjjyo1qhy1lmhpki\"\n}",
        "options": {
          "timeout": 30000
        }
      },
